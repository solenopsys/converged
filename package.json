{
  "name": "converged",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "back/back-core",
    "back/microservices/**/*",
    "front/front-core",
    "front/libraries/*",
    "front/libraries/*/*",
    "front/spa",
    "front/ssr",
    "front/landing",
    "front/microfrontends/**/*",
    "tools/*",
    "tools/nrpc",
    "tools/dag/core",
    "tools/dag/workflows/*",
    "tools/generated/*",
    "navite/libs/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.3.14",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@types/node": "^25.9.5",
    "@typescript-eslint/typescript-estree": "^8.67.0",
    "@unocss/preset-icons": "^66.7.5",
    "@unocss/reset": "^66.7.5",
    "bun-transport": "workspace:*",
    "croner": "^10.0.1",
    "fflate": "^0.8.3",
    "g-agent": "workspace:*",
    "g-auth": "workspace:*",
    "g-files": "workspace:*",
    "g-modelconvertor": "workspace:*",
    "g-sales": "workspace:*",
    "g-smtp": "workspace:*",
    "g-store": "workspace:*",
    "globals": "^17.11.0",
    "i18next": "^26.3.6",
    "i18next-http-backend": "^3.0.6",
    "jose": "^6.2.9",
    "lightningcss": "^1.33.0",
    "msgpackr": "^1.12.1",
    "preact-render-to-string": "^6.7.0",
    "react-i18next": "^17.0.11",
    "tailwind-merge": "^3.6.0",
    "unocss": "^66.7.5",
    "uuid": "^13.0.2",
    "vivus": "^0.4.6",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "dev": "bun i && NODE_ENV=development bun run --cwd ../club/tools/configurator src/cli.ts dev --project=converged --env-file=../confs/converged-local.env --no-ui",
    "dev:ui": "NODE_ENV=development bun run --cwd ../club/tools/configurator src/cli.ts dev --project=converged --env-file=../confs/converged-local.env --ui-only",
    "dev:all": "bun i && NODE_ENV=development bun run --cwd ../club/tools/configurator src/cli.ts dev --project=converged --env-file=../confs/converged-local.env",
    "build:mono": "bun run --cwd ../club/tools/configurator src/cli.ts build --project=converged --section=mono",
    "build:cloud": "bun run --cwd ../club/tools/configurator src/cli.ts build --project=converged --section=cloud",
    "build:ui": "bun run --cwd ../club cli release ship converged ui",
    "build:ms": "bun run --cwd ../club cli release ship converged ms",
    "build:all": "bun run build:mono && bun run build:cloud",
    "cli": "bun run --env-file=../confs/cli-converged-dev.env tools/cli/src/cli.ts --commands=tools/commands",
    "clip": "bun run --env-file=../confs/cli-converged-prod.env tools/cli/src/cli.ts --commands=tools/commands",
    "secrets": "bun run --cwd ../club/tools/configurator src/cli.ts secrets --project=converged --env-file=converged-prod.env --output=/home/alexstorm/distrib/4ir/gestalt/final/confs",
    "k3s:import": "podman save converged:latest -o /tmp/converged.tar && sudo k3s ctr images import /tmp/converged.tar && rm /tmp/converged.tar",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "storybook": "bun run --cwd tools/storybook sb",
    "storybook:build": "bun run --cwd tools/storybook build-storybook",
    "gen": "bun run --cwd tools/nrpc src/gen-all.ts ../types ../generated",
    "store-check": "BOOTSTRAP_ENV_DIR=../../confs bun run --env-file=../../confs/converged.env tools/store-check.ts",
    "test:transport": "bun tools/transport-integration.ts",
    "check:microservices": "bun tools/check-microservice-isolation.ts",
    "cp": "rm -rf /home/alexstorm/distrib/4ir/gestalt/final/data/converged/scripts-ms/scripts/data/* && cp -r /home/alexstorm/distrib/4ir/gestalt/final/converged/back/workflows/. /home/alexstorm/distrib/4ir/gestalt/final/data/converged/scripts-ms/scripts/data/"
  }
}
