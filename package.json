{
	"name": "converged",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"workspaces": [
		"core/backend",
		"core/dag/core",
		"core/dag/lib",
		"core/frontend/front-core",
		"core/frontend/landing",
		"core/frontend/spa",
		"core/frontend/ssr",
		"core/frontend/libraries/*",
		"core/frontend/libraries/*/*",
		"core/native/libs/cruller-md4c",
		"core/native/libs/cruller-transport",
		"core/native/apps/resonus/providers",
		"core/tools/cli",
		"core/tools/docs",
		"core/tools/nrpc",
		"core/tools/registry",
		"core/tools/translation",
		"modules/commands",
		"modules/generated/*",
		"modules/microfrontends/*/*",
		"modules/microservices/*/*",
		"modules/workflows/*"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@playwright/test": "^1.62.1",
		"@types/bun": "^1.3.14",
		"typescript": "6.0.3"
	},
	"dependencies": {
		"@types/node": "^25.9.5",
		"@typescript-eslint/typescript-estree": "^8.67.0",
		"@unocss/preset-icons": "^66.8.0",
		"@unocss/reset": "^66.8.0",
		"croner": "^10.0.1",
		"fflate": "^0.8.3",
		"globals": "^17.11.0",
		"i18next": "^26.3.6",
		"i18next-http-backend": "^3.0.6",
		"jose": "^6.2.9",
		"lightningcss": "^1.33.0",
		"msgpackr": "^1.12.1",
		"preact-render-to-string": "^6.7.0",
		"react-i18next": "^17.0.11",
		"tailwind-merge": "^3.6.0",
		"unocss": "^66.8.0",
		"uuid": "^13.0.2",
		"vivus": "^0.4.6",
		"yaml": "^2.9.0"
	},
	"scripts": {
		"gen": "bun run core/tools/nrpc/src/gen-all.ts modules/types modules/generated && bun run core/tools/nrpc/src/gen-all.ts core/native/types modules/generated rt",
		"dev": "bun i && NODE_ENV=development bun run core/tools/dev/src/cli.ts --env-file=../confs/dev/converged.env --no-ui",
		"dev:ui": "NODE_ENV=development bun run core/tools/dev/src/cli.ts --env-file=../confs/dev/converged.env --ui-only",
		"dev:all": "bun i && NODE_ENV=development bun run core/tools/dev/src/cli.ts --env-file=../confs/dev/converged.env",
		"build:modules": "bun run --env-file=../confs/prod/cli-converged.env core/tools/registry/src/build.ts",
		"build:doc": "bun run --env-file=../confs/dev/converged.env core/tools/docs/src/cli.ts site ecosystem translations",
		"cli": "bun run --env-file=../confs/dev/cli-converged-dev.env core/tools/cli/src/cli.ts --commands=modules/commands",
		"clip": "bun run --env-file=../confs/prod/cli-converged.env core/tools/cli/src/cli.ts --commands=modules/commands",
		"secrets": "bun run core/tools/secrets/src/cli.ts --project=converged --env=../confs/prod/converged.env",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check ."
	}
}
