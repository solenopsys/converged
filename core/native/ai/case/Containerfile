FROM alpine:3.22
WORKDIR /app

COPY --chmod=755 zig-out/bin/case /app/case
COPY --chmod=644 zig-out/lib/libonnxruntime.so /app/lib/libonnxruntime.so
COPY models/granite97.onnx /app/models/granite97.onnx
COPY models/granite97.onnx.data /app/models/granite97.onnx.data
COPY models/tokenizer.json /app/models/tokenizer.json
RUN adduser -D -H -u 1000 case

USER case
ENV CASE_HOST=0.0.0.0 \
    CASE_PORT=8000 \
    CASE_MODEL=/app/models/granite97.onnx \
    CASE_TOKENIZER=/app/models/tokenizer.json \
    LD_LIBRARY_PATH=/app/lib
EXPOSE 8000
ENTRYPOINT ["/app/case"]
