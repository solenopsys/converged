FROM debian:bookworm-slim AS runtime
WORKDIR /app

# TLS roots for outbound HTTPS to OpenAI / Gemini signaling APIs
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY ./zig-out/x86_64-gnu/bin/resonus /app/resonus
COPY ./zig-out/x86_64-gnu/lib/libdatachannel.so /app/libdatachannel.so
COPY ./zig-out/x86_64-gnu/lib/libdatachannel_wrapper.so /app/libdatachannel_wrapper.so
COPY ./zig-out/x86_64-gnu/lib/libmbedtls.so /app/libmbedtls.so
COPY ./zig-out/x86_64-gnu/lib/libmbedcrypto.so /app/libmbedcrypto.so
COPY ./zig-out/x86_64-gnu/lib/libmbedcrypto.so.18 /app/libmbedcrypto.so.18
COPY ./zig-out/x86_64-gnu/lib/libmbedx509.so /app/libmbedx509.so
COPY ./zig-out/x86_64-gnu/lib/libmbedx509.so.9 /app/libmbedx509.so.9
COPY ./zig-out/x86_64-gnu/lib/libtfpsacrypto.so.2 /app/libtfpsacrypto.so.2
COPY ./zig-out/x86_64-gnu/lib/libbaresip.so /app/libbaresip.so
COPY ./zig-out/x86_64-gnu/lib/libbaresip_wrapper.so /app/libbaresip_wrapper.so
COPY ./zig-out/x86_64-gnu/lib/libtransport.so /app/libtransport.so
COPY ./zig-out/x86_64-gnu/lib/libqjs.so /app/libqjs.so
COPY ./zig-out/x86_64-gnu/lib/libzimq.so /app/libzimq.so
# The two JS payloads the gate evaluates at startup: the policy script and
# the provider bundle (hooks.js + decode tables + manifest.json).
COPY ./scripts /app/scripts
COPY ./providers/dist /app/providers/dist
RUN chmod +x /app/resonus && chmod 644 /app/lib*.so && mkdir -p /app/socket && chown -R 1000:1000 /app
RUN useradd -u 1000 -M -r -s /usr/sbin/nologin default || true
USER 1000

ENV LLM_GATE_HTTP_HOST=0.0.0.0 \
    LLM_GATE_HTTP_PORT=8090 \
    LD_LIBRARY_PATH=/app \
    RESONUS_FUJIN_ZIMQ_LIB=/app/libzimq.so \
    LLM_GATE_LIBDATACHANNEL_LIB=/app/libdatachannel.so \
    LLM_GATE_LIBDATACHANNEL_WRAPPER_LIB=/app/libdatachannel_wrapper.so \
    LLM_GATE_BARESIP_LIB=/app/libbaresip.so \
    LLM_GATE_BARESIP_WRAPPER_LIB=/app/libbaresip_wrapper.so \
    LLM_GATE_MBEDTLS_LIB=/app/libmbedtls.so \
    LLM_GATE_QJS_LIB=/app/libqjs.so \
    LLM_GATE_POLICY_SCRIPT=/app/scripts/default.js \
    RESONUS_PROVIDERS_DIR=/app/providers/dist \
    LLM_GATE_VALKEY_URL=redis://127.0.0.1:6379/0 \
    LLM_GATE_VALKEY_KEY_PREFIX=cache \
    LLM_GATE_SIP_ENABLED=true \
    LLM_GATE_SIP_PORT=5060

EXPOSE 8090
EXPOSE 5060/udp

CMD ["/app/resonus", "serve"]
