{
  "kind": "Tenant",
  "solutions": [
    {
      "apiVersion": "ptah.io/v1alpha1",
      "kind": "Solution",
      "metadata": {
        "name": "cnc-club"
      },
      "spec": {
        "platform": "converged",
        "microservices": [
          "geo",
          "companies"
        ]
      }
    }
  ],
  "tenants": [],
  "object": {
    "apiVersion": "ptah.io/v1alpha1",
    "kind": "Tenant",
    "metadata": {
      "name": "democnc",
      "generation": 2
    },
    "spec": {
      "platform": "converged",
      "storageSize": "20Gi",
      "domains": [
        "shop.example.com"
      ]
    }
  },
  "platform": {
    "apiVersion": "ptah.io/v1alpha1",
    "kind": "Platform",
    "metadata": {
      "name": "converged"
    },
    "spec": {
      "profile": "cloud",
      "namespace": "converged",
      "domainBase": "4ir.club",
      "secretName": "converged-secrets",
      "images": {
        "ui": "reg/ui:1",
        "ms": "reg/ms:1"
      },
      "storage": {
        "image": "reg/behemoth:1",
        "size": "5Gi",
        "port": 9000,
        "mountBase": "/app/data",
        "storageClassName": "local-path",
        "volumeSource": {
          "hostPath": {
            "path": "/var/lib/ptah/{{volume}}",
            "type": "DirectoryOrCreate"
          }
        },
        "cachePort": 6379
      },
      "apps": {
        "fujin": {
          "image": "reg/fujin:1",
          "ports": {
            "ws": 8087,
            "zmq": 5557
          }
        }
      },
      "gateway": {
        "hosts": [
          "*.4ir.club"
        ],
        "tls": {
          "secretName": "4ir-club-tls"
        },
        "className": "traefik"
      }
    }
  }
}
