{
  "kind": "Platform",
  "solutions": [
    {
      "apiVersion": "ptah.io/v1alpha1",
      "kind": "Solution",
      "metadata": {
        "name": "cnc-club"
      },
      "spec": {
        "platform": "converged",
        "microservices": [
          "geo",
          "companies",
          "places"
        ],
        "microfrontends": [
          "geo",
          "places"
        ],
        "workflows": [
          {
            "name": "wf-leads",
            "script": "workflows/wf-leads.js",
            "periodMs": 600000
          }
        ],
        "env": {
          "CLUB_MODE": "on"
        }
      }
    }
  ],
  "tenants": [
    {
      "apiVersion": "ptah.io/v1alpha1",
      "kind": "Tenant",
      "metadata": {
        "name": "democnc"
      },
      "spec": {
        "platform": "converged"
      }
    }
  ],
  "object": {
    "apiVersion": "ptah.io/v1alpha1",
    "kind": "Platform",
    "metadata": {
      "name": "converged",
      "generation": 1
    },
    "spec": {
      "profile": "cloud",
      "namespace": "converged",
      "domainBase": "4ir.club",
      "secretName": "converged-secrets",
      "images": {
        "ui": "public.ecr.aws/i5x9u8b2/converged-ui:latest",
        "ms": "public.ecr.aws/i5x9u8b2/converged-ms:latest"
      },
      "cache": {
        "image": "docker.io/valkey/valkey:8.1-alpine",
        "port": 6379
      },
      "storage": {
        "image": "public.ecr.aws/i5x9u8b2/behemoth:latest",
        "size": "5Gi",
        "port": 9000,
        "mountBase": "/app/data",
        "storageClassName": "local-path"
      },
      "apps": {
        "fujin": {
          "image": "public.ecr.aws/i5x9u8b2/fujin:latest",
          "ports": {
            "ws": 8087,
            "zmq": 5557
          }
        },
        "centimanus": {
          "image": "public.ecr.aws/i5x9u8b2/centimanus:latest",
          "fujinTarget": "centimanus",
          "fujinEndpointEnv": "CENTIMANUS_FUJIN_ZMQ_ENDPOINT",
          "ports": {
            "http": 9000
          }
        }
      },
      "gateway": {
        "hosts": [
          "*.4ir.club"
        ],
        "tls": {
          "secretName": "4ir-club-tls",
          "issuer": "4ir-club-cluster-issuer",
          "issuerKind": "ClusterIssuer",
          "dnsNames": [
            "4ir.club",
            "*.4ir.club"
          ]
        },
        "className": "traefik"
      }
    }
  }
}
