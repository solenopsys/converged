{
  "kind": "Platform",
  "solutions": [
    {
      "apiVersion": "ptah.io/v1alpha1",
      "kind": "Solution",
      "metadata": { "name": "requests" },
      "spec": {
        "platform": "converged",
        "microservices": ["files", "store", "requests"],
        "microfrontends": ["requests"],
        "processors": ["curaengine", "opencamlib"],
        "workflows": [
          { "name": "wf-file-analysis", "script": "workflows/wf-file-analysis.js" }
        ]
      }
    }
  ],
  "tenants": [],
  "object": {
    "apiVersion": "ptah.io/v1alpha1",
    "kind": "Platform",
    "metadata": { "name": "converged", "generation": 1 },
    "spec": {
      "profile": "multi",
      "namespace": "converged",
      "domainBase": "4ir.club",
      "secretName": "converged-secrets",
      "images": {
        "ui": "public.ecr.aws/i5x9u8b2/converged-ui:latest",
        "ms": "public.ecr.aws/i5x9u8b2/converged-ms:latest"
      },
      "registry": {
        "url": "https://s3.eu-central-1.amazonaws.com/converged-modules",
        "solutions": "solutions/converged.json",
        "revision": "2026-08-21",
        "cacheSize": "4Gi"
      },
      "cache": { "image": "docker.io/valkey/valkey:8.1-alpine", "port": 6379 },
      "storage": {
        "image": "public.ecr.aws/i5x9u8b2/behemoth:latest",
        "size": "20Gi",
        "port": 9000,
        "mountBase": "/app/data",
        "storageClassName": "local-path",
        "volumeSource": {
          "hostPath": { "path": "/var/lib/ptah/{{volume}}", "type": "DirectoryOrCreate" }
        }
      },
      "shards": [
        { "name": "alpha", "scopes": ["acme", "globex"], "size": "50Gi" },
        { "name": "rest", "scopes": ["*"] }
      ],
      "apps": {
        "fujin": {
          "image": "public.ecr.aws/i5x9u8b2/fujin:latest",
          "ports": { "ws": 8087, "zmq": 5557 }
        },
        "centimanus": {
          "image": "public.ecr.aws/i5x9u8b2/centimanus:latest",
          "fujinTarget": "centimanus",
          "fujinEndpointEnv": "CENTIMANUS_FUJIN_ZMQ_ENDPOINT",
          "ports": { "http": 9000 }
        },
        "resonus": {
          "image": "public.ecr.aws/i5x9u8b2/resonus:latest",
          "fujinTarget": "resonus",
          "fujinEndpointEnv": "RESONUS_FUJIN_ZMQ_ENDPOINT"
        }
      },
      "processors": {
        "curaengine": {
          "image": "public.ecr.aws/i5x9u8b2/curaengine:latest",
          "fujinTarget": "curaengine",
          "fujinEndpointEnv": "CURAENGINE_FUJIN_ZMQ_ENDPOINT"
        },
        "opencamlib": {
          "image": "public.ecr.aws/i5x9u8b2/opencamlib:latest",
          "fujinTarget": "opencamlib",
          "fujinEndpointEnv": "OPENCAMLIB_FUJIN_ZMQ_ENDPOINT"
        }
      },
      "gateway": {
        "className": "traefik",
        "hosts": ["*.4ir.club"],
        "tls": {
          "secretName": "4ir-club-tls",
          "issuer": "4ir-club-cluster-issuer",
          "issuerKind": "ClusterIssuer",
          "dnsNames": ["4ir.club", "*.4ir.club"]
        }
      }
    }
  }
}
