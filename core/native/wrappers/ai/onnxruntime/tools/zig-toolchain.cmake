set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_COMPILER "${CMAKE_CURRENT_LIST_DIR}/zig-cc.sh")
set(CMAKE_CXX_COMPILER "${CMAKE_CURRENT_LIST_DIR}/zig-cxx.sh")
if(DEFINED ENV{ORT_ZIG_TARGET})
  string(REGEX MATCH "^[^-]+" ORT_ZIG_ARCH "$ENV{ORT_ZIG_TARGET}")
  set(CMAKE_SYSTEM_PROCESSOR "${ORT_ZIG_ARCH}")
  set(CMAKE_SYSTEM_PROCESSOR "${ORT_ZIG_ARCH}" CACHE STRING "Target processor" FORCE)
endif()
