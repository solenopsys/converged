{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["bun"],
		"paths": {
			"md-tools/renderer": [
				"../../frontend/libraries/md-tools/src/markdown-renderer.tsx"
			],
			"cruller-md4c": ["../../native/libs/cruller-md4c/src/index.ts"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"]
}
