# Everything the image builds for itself, and everything it must never carry.
#
# node_modules is rebuilt by `bun install` in the builder stage: copying the
# host's would import binaries built against the host libc.
**/node_modules
**/.git
**/.zig-cache
**/zig-cache
**/zig-out
**/dist
**/.turbo
**/.next

# Vendored native sources: hundreds of megabytes of upstream trees that no ui
# or ms code path reads.
converged/core/native/wrappers/*/*/vendor

# `wrappers/artifacts/libs` is deliberately NOT excluded. The per-package
# bin-libs directories are symlinks into it, so dropping it leaves those links
# dangling and the image build fails on a copy rather than at run time. It is
# 11 MB of content-addressed shared objects.

# Local state and secrets. `confs/` holds real credentials; the platform
# supplies them from a Secret at runtime.
data
confs
**/*.env
**/.env
**/.env.*
**/*.tgz
**/*.log

# Documentation and tooling that no runtime path touches.
**/.github
**/storybook-static
